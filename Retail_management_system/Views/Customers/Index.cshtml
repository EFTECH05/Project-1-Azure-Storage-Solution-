@model List<Retail_management_system.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Customers</h1>

            <p class="text-muted mb-0">
                Manage ABC Retail customer profiles and information.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <a asp-controller="Customers"
               asp-action="Create"
               class="btn btn-primary">
                + Add Customer
            </a>
        </div>

    </div>


    <!-- Customer Card -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="card-title mb-0">
                    Customer List
                </h5>

                <span class="badge bg-primary">
                    @Model.Count Customers
                </span>

            </div>


            @if (Model.Count == 0)
            {
                <div class="text-center py-5">

                    <h5>No customers found</h5>

                    <p class="text-muted">
                        You haven't added any customers yet.
                    </p>

                    <a asp-controller="Customers"
                       asp-action="Create"
                       class="btn btn-primary">
                        Add Your First Customer
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>Customer ID</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Address</th>
                                <th class="text-center">Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var customer in Model)
                            {
                                <tr>

                                    <td>
                                        <small class="text-muted">
                                            @customer.RowKey
                                        </small>
                                    </td>

                                    <td class="fw-semibold">
                                        @customer.Name
                                    </td>

                                    <td>
                                        @customer.Email
                                    </td>

                                    <td>
                                        @customer.Phone
                                    </td>

                                    <td>
                                        @customer.Address
                                    </td>

                                    <td class="text-center">

                                        <form asp-controller="Customers"
                                              asp-action="Delete"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this customer?');">

                                            <input type="hidden"
                                                   name="partitionKey"
                                                   value="@customer.PartitionKey" />

                                            <input type="hidden"
                                                   name="rowKey"
                                                   value="@customer.RowKey" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>