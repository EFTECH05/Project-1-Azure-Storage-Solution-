
@model List<Retail_management_system.Models.Product>

@{
    ViewData["Title"] = "Inventory";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Inventory</h1>

            <p class="text-muted mb-0">
                Manage product stock and inventory levels.
            </p>
        </div>

        <div class="mt-3 mt-md-0">

            <span class="badge bg-primary fs-6">
                @Model.Count Products
            </span>

        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">

            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- Inventory Summary -->
    <div class="row g-4 mb-4">

        <!-- Total Products -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Products
                    </h6>

                    <h2 class="fw-bold">
                        @Model.Count
                    </h2>

                </div>

            </div>

        </div>


        <!-- Total Stock -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Stock
                    </h6>

                    <h2 class="fw-bold">
                        @Model.Sum(p => p.StockQuantity)
                    </h2>

                </div>

            </div>

        </div>


        <!-- Low Stock -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Low Stock Products
                    </h6>

                    <h2 class="fw-bold text-warning">
                        @Model.Count(p => p.StockQuantity > 0 && p.StockQuantity <= 5)
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- Inventory Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">

                <h5 class="card-title mb-0">
                    Inventory List
                </h5>

                <div class="mt-3 mt-md-0">

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-outline-primary btn-sm me-2">
                        Manage Products
                    </a>

                    <a asp-controller="Orders"
                       asp-action="Index"
                       class="btn btn-outline-success btn-sm">
                        View Orders
                    </a>

                </div>

            </div>


            @if (Model.Count == 0)
            {
                <div class="text-center py-5">

                    <h5>No inventory found</h5>

                    <p class="text-muted">
                        Add products to start managing your inventory.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Create"
                       class="btn btn-primary">
                        Add Product
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>Product ID</th>
                                <th>Image</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Inventory Queue</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var product in Model)
                            {
                                <tr>

                                    <!-- Product ID -->
                                    <td>
                                        <small class="text-muted">
                                            @product.RowKey
                                        </small>
                                    </td>


                                    <!-- Product Image -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl"
                                                 alt="@product.Name"
                                                 class="rounded border"
                                                 style="width:60px;height:60px;object-fit:cover;"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                            <div class="bg-light border rounded align-items-center justify-content-center"
                                                 style="width:60px;height:60px;display:none;">

                                                <small class="text-muted text-center">
                                                    Image unavailable
                                                </small>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="bg-light border rounded d-flex align-items-center justify-content-center"
                                                 style="width:60px;height:60px;">

                                                <small class="text-muted text-center">
                                                    No image
                                                </small>

                                            </div>
                                        }

                                    </td>


                                    <!-- Product -->
                                    <td class="fw-semibold">
                                        @product.Name
                                    </td>


                                    <!-- Category -->
                                    <td>

                                        <span class="badge bg-secondary">
                                            @product.Category
                                        </span>

                                    </td>


                                    <!-- Price -->
                                    <td>
                                        R @product.Price.ToString("N2")
                                    </td>


                                    <!-- Stock -->
                                    <td class="fw-semibold">
                                        @product.StockQuantity
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (product.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger">
                                                Out of Stock
                                            </span>
                                        }
                                        else if (product.StockQuantity <= 5)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Low Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                In Stock
                                            </span>
                                        }

                                    </td>


                                    <!-- Record Inventory -->
                                    <td>

                                        <form asp-controller="Inventory"
                                              asp-action="RecordInventory"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="productId"
                                                   value="@product.RowKey" />

                                            <input type="hidden"
                                                   name="productName"
                                                   value="@product.Name" />

                                            <input type="hidden"
                                                   name="stockQuantity"
                                                   value="@product.StockQuantity" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-primary">

                                                Record

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- Azure Information -->
    <div class="card shadow-sm border-0 mt-4 mb-4">

        <div class="card-body">

            <h5 class="fw-bold mb-3">
                Azure Inventory Management
            </h5>

            <p class="text-muted mb-2">
                Product information and stock levels are retrieved from
                <strong>Azure Table Storage</strong>.
            </p>

            <p class="text-muted mb-2">
                Product images are stored in
                <strong>Azure Blob Storage</strong>.
            </p>

            <p class="text-muted mb-2">
                Inventory management details are recorded in
                <strong>Azure Queue Storage</strong>.
            </p>

            <p class="text-muted mb-0">
                Application activity and error logs are stored using
                <strong>Azure Files</strong>.
            </p>

        </div>

    </div>

</div>
```
