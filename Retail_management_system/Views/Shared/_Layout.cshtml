<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ABC Retail</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Project CSS -->
    <link rel="stylesheet"
          href="~/Retail_management_system.styles.css"
          asp-append-version="true" />

</head>


<body>

    <!-- ==============================
         NAVIGATION BAR
         ============================== -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

            <div class="container">

                <!-- ABC RETAIL LOGO / BRAND -->

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">
                        A
                    </span>

                    ABC Retail

                </a>


                <!-- MOBILE MENU BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION LINKS -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">


                        <!-- DASHBOARD -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Dashboard

                            </a>

                        </li>


                        <!-- CUSTOMERS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Customers"
                               asp-action="Index">

                                Customers

                            </a>

                        </li>


                        <!-- PRODUCTS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Products"
                               asp-action="Index">

                                Products

                            </a>

                        </li>


                        <!-- ORDERS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               href="#">

                                Orders

                            </a>

                        </li>


                        <!-- INVENTORY -->

                        <li class="nav-item">

                            <a class="nav-link"
                               href="#">

                                Inventory

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- ==============================
         MAIN CONTENT
         ============================== -->

    <main>

        @RenderBody()

    </main>


    <!-- ==============================
         FOOTER
         ============================== -->

    <footer class="site-footer">

        <div class="container">

            <div class="row align-items-center">


                <!-- FOOTER BRAND -->

                <div class="col-md-6 text-center text-md-start">

                    <strong>
                        ABC Retail
                    </strong>

                    <span class="footer-divider">
                        |
                    </span>

                    Cloud Management System

                </div>


                <!-- COPYRIGHT -->

                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">

                    &copy; 2026 ABC Retail

                </div>

            </div>

        </div>

    </footer>


    <!-- ==============================
         JAVASCRIPT
         ============================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>