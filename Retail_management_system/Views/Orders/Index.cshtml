@model List<string>

@{
    ViewData["Title"] = "Orders";
}

<div class="container mt-4 mb-5">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Orders
            </h1>

            <p class="text-muted mb-0">
                Manage customer orders using Azure Queue Storage.
            </p>
        </div>

        <div class="mt-3 mt-md-0">

            <a asp-controller="Orders"
               asp-action="Create"
               class="btn btn-primary">
                + Create Order
            </a>

        </div>

    </div>


    <!-- Orders Card -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="card-title mb-0">
                    Order Queue
                </h5>

                <span class="badge bg-primary">
                    @Model.Count Orders
                </span>

            </div>


            @if (Model.Count == 0)
            {
                <!-- No Orders -->
                <div class="text-center py-5">

                    <h5>
                        No orders found
                    </h5>

                    <p class="text-muted">
                        There are currently no orders in the Azure Queue.
                    </p>

                    <a asp-controller="Orders"
                       asp-action="Create"
                       class="btn btn-primary">
                        Create Your First Order
                    </a>

                </div>
            }
            else
            {
                <!-- Orders -->
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>
                                    #
                                </th>

                                <th>
                                    Order Message
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <tr>

                                    <td>
                                        @(i + 1)
                                    </td>

                                    <td>
                                        <code>
                                            @Model[i]
                                        </code>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- Azure Queue Information -->
    <div class="card shadow-sm border-0 mt-4">

        <div class="card-body">

            <h5 class="fw-bold">
                Azure Queue Storage
            </h5>

            <p class="text-muted mb-0">
                Orders are sent as messages to the
                <strong>orders</strong> Azure Queue.
                This allows order processing to happen asynchronously.
            </p>

        </div>

    </div>

</div>